{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/catalogue.html", "destination": "/catalogue", "permanent": true },
    { "source": "/vendues.html", "destination": "/vendues", "permanent": true },
    { "source": "/fiche.html", "destination": "/fiche", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/voitures/:slug", "destination": "/fiche.html" },
    { "source": "/voitures", "destination": "/index.html" },
    { "source": "/catalogue", "destination": "/catalogue.html" },
    { "source": "/fiche", "destination": "/fiche.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/vendues", "destination": "/vendues.html" },
    { "source": "/(.*)", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
